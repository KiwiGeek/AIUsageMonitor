<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="About Seth's AI Usage Monitor"
                 Width="540"
                 Height="430"
                 MinWidth="500"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="About"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="22"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="VersionTextBlock"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Border Margin="0,18,0,18"
                        Padding="16"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Created by Seth A. Robinson"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Windows tray app for checking remaining AI subscription usage across Anthropic, OpenAI/Codex, Gemini, and Cursor."
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Developed with significant assistance from AI tools."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Links"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <UniformGrid Margin="0,10,0,0"
                             Columns="2"
                             Rows="3">
                    <TextBlock Margin="0,0,12,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://github.com/SethRobinson/AIUsageMonitor"
                                   Click="LinkOnClick">GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://www.rtsoft.com/"
                                   Click="LinkOnClick">Homepage</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,12,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://www.codedojo.com/"
                                   Click="LinkOnClick">Blog</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://twitter.com/rtsoft"
                                   Click="LinkOnClick">Twitter</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,12,0"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://bsky.app/profile/rtsoft.com"
                                   Click="LinkOnClick">Bluesky</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://mastodon.gamedev.place/@rtsoft"
                                   Click="LinkOnClick">Mastodon</Hyperlink>
                    </TextBlock>
                </UniformGrid>
            </StackPanel>

            <ui:Button Grid.Row="1"
                       MinWidth="92"
                       HorizontalAlignment="Right"
                       Appearance="Primary"
                       Content="Close"
                       Click="CloseButtonOnClick" />
        </Grid>
    </Grid>
</local:FluentDialogWindow>
