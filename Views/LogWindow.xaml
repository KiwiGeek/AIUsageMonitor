<local:FluentAppWindow x:Class="AIUsageMonitor.Views.LogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Seth's AI Usage Monitor Logs"
                 Width="760"
                 Height="460"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Logs"
                     Grid.Row="0" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1"
                           MinWidth="112"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Copy Selected"
                           Click="CopySelectedButtonOnClick" />
                <ui:Button Grid.Column="2"
                           MinWidth="92"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Copy All"
                           Click="CopyAllButtonOnClick" />
                <ui:Button Grid.Column="3"
                           MinWidth="92"
                           Appearance="Secondary"
                           Content="Clear"
                           Click="ClearButtonOnClick" />
            </Grid>

            <DataGrid x:Name="LogsDataGrid"
                      Grid.Row="1"
                      Margin="0,16,0,14"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      GridLinesVisibility="Horizontal"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                      RowBackground="{DynamicResource ControlFillColorDefaultBrush}"
                      AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}" />

            <TextBlock x:Name="LogPathTextBlock"
                       Grid.Row="2"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</local:FluentAppWindow>
