<Window x:Class="AIUsageMonitor.Views.GitHubCopilotSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Copilot Setup"
        Width="500"
        Height="300"
        MinWidth="460"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#15171D"
        Foreground="#F9FAFB"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="22"
            Background="#15171D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="GitHub Copilot Setup"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#F9FAFB" />

            <StackPanel Grid.Row="1"
                        Margin="0,20,0,16">
                <TextBlock Text="Personal Access Token"
                           Foreground="#A8AFBA"
                           FontSize="12" />
                <TextBox x:Name="ApiKeyTextBox"
                         Height="34"
                         Margin="0,6,0,0"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         Background="#1D2028"
                         BorderBrush="#343A46"
                         Foreground="#F9FAFB"
                         CaretBrush="#F9FAFB"
                         FontSize="13"
                         FontFamily="Consolas" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#8B93A1"
                           FontSize="12"
                           TextWrapping="Wrap">
                    Create a classic PAT (no scopes required) at
                    <Hyperlink NavigateUri="https://github.com/settings/tokens"
                               RequestNavigate="HyperlinkOnRequestNavigate">
                        github.com/settings/tokens
                    </Hyperlink>
                    The account must have an active Copilot subscription. Fine-grained tokens may need the Copilot Editor Chat (read-only) permission.
                </TextBlock>
                <TextBlock x:Name="ValidationTextBlock"
                           Margin="0,10,0,0"
                           Foreground="#FCA5A5"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="92"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Click="CancelButtonOnClick" />
                <Button Width="92"
                        Height="34"
                        Content="Save"
                        Click="SaveButtonOnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
