<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.GitHubCopilotSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="GitHub Copilot Setup"
                 Width="500"
                 Height="300"
                 MinWidth="460"
                 MinHeight="280"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="GitHub Copilot Setup"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Personal Access Token"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox x:Name="ApiKeyTextBox"
                            Height="34"
                            Margin="0,6,0,0"
                            FontFamily="Consolas"
                            FontSize="13"
                            PlaceholderText="ghp_..." />
                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap">
                    Create a classic PAT (no scopes required) at
                    <Hyperlink NavigateUri="https://github.com/settings/tokens"
                               RequestNavigate="HyperlinkOnRequestNavigate">
                        github.com/settings/tokens
                    </Hyperlink>
                    The account must have an active Copilot subscription. Fine-grained tokens may need the Copilot Editor Chat (read-only) permission.
                </TextBlock>
                <TextBlock x:Name="ValidationTextBlock"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Width="92"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Cancel"
                           Click="CancelButtonOnClick" />
                <ui:Button Width="92"
                           Appearance="Primary"
                           Content="Save"
                           Click="SaveButtonOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</local:FluentDialogWindow>
