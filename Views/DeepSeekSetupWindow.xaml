<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.DeepSeekSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DeepSeek Setup"
                 Width="500"
                 Height="280"
                 MinWidth="460"
                 MinHeight="260"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="DeepSeek Setup"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="API key"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox x:Name="ApiKeyTextBox"
                            Height="34"
                            Margin="0,6,0,0"
                            FontFamily="Consolas"
                            FontSize="13"
                            PlaceholderText="sk-..." />
                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap">
                    Create or copy an API key from
                    <Hyperlink NavigateUri="https://platform.deepseek.com/api_keys"
                               RequestNavigate="HyperlinkOnRequestNavigate">
                        platform.deepseek.com/api_keys
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="ValidationTextBlock"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource ErrorTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Width="92"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Cancel"
                           Click="CancelButtonOnClick" />
                <ui:Button Width="92"
                           Appearance="Primary"
                           Content="Save"
                           Click="SaveButtonOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</local:FluentDialogWindow>
