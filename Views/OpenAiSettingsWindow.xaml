<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.OpenAiSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OpenAI Settings"
                 Width="460"
                 Height="260"
                 MinWidth="420"
                 MinHeight="240"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="OpenAI Settings"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <!-- Enabled -->
                <CheckBox Margin="0,4,0,16"
                          FontSize="13"
                          Content="Enable OpenAI"
                          IsChecked="{Binding OpenAiEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Reads quota snapshots from local Codex CLI session logs. No API key required." />

                <TextBlock Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap">
                    Install and sign in at
                    <Hyperlink NavigateUri="https://help.openai.com/en/articles/11096431"
                               RequestNavigate="HyperlinkOnRequestNavigate">help.openai.com — Codex CLI setup</Hyperlink>
                </TextBlock>

            </StackPanel>

            <TextBlock Grid.Row="1"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Changes are saved automatically." />
        </Grid>
    </Grid>
</local:FluentDialogWindow>
