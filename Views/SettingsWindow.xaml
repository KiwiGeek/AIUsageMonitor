<local:FluentAppWindow x:Class="AIUsageMonitor.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Seth's AI Usage Monitor Settings"
                 Width="540"
                 Height="700"
                 MinWidth="500"
                 MinHeight="620"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Settings"
                     Grid.Row="0" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Margin="0,0,0,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Update interval" />
                        <DockPanel Margin="0,8,0,0">
                            <ui:TextBox x:Name="UpdateIntervalTextBox"
                                        Width="96"
                                        FontSize="14" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="minutes" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Default is 20. Manual refresh still runs immediately." />
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Providers" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Enabled providers appear in the overlay and are included in refreshes." />
                        <Border Margin="0,10,0,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer MaxHeight="380"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Padding="12"
                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AnthropicProviderEnabledCheckBox"
                                                          Content="Anthropic"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Claude Code local OAuth and status-line quota data."
                                                           TextWrapping="Wrap" />
                                                <CheckBox x:Name="ClaudeStatusExporterCheckBox"
                                                          Margin="24,10,0,0"
                                                          Content="Install Claude Code status exporter automatically"
                                                          FontSize="12" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Width="82"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Appearance="Secondary"
                                                       Click="ProviderSetupButtonOnClick"
                                                       Content="Setup"
                                                       Tag="Anthropic" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="OpenAiProviderEnabledCheckBox"
                                                          Content="OpenAI"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Codex local session logs and CLI quota refreshes."
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Width="82"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Appearance="Secondary"
                                                       Click="ProviderSetupButtonOnClick"
                                                       Content="Setup"
                                                       Tag="OpenAI" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="GeminiProviderEnabledCheckBox"
                                                          Content="Gemini"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Gemini CLI credentials, quota status export, and local session data."
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Width="82"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Appearance="Secondary"
                                                       Click="ProviderSetupButtonOnClick"
                                                       Content="Setup"
                                                       Tag="Gemini" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="CursorProviderEnabledCheckBox"
                                                          Content="Cursor"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Personal dashboard login or Teams Admin API spend data."
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="CursorModeSummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Width="82"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Appearance="Secondary"
                                                       Click="CursorSetupButtonOnClick"
                                                       Content="Setup" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="DeepSeekProviderEnabledCheckBox"
                                                          Content="DeepSeek"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="DeepSeek API credit balance via API key."
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="DeepSeekApiKeySummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Width="82"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Appearance="Secondary"
                                                       Click="DeepSeekSetupButtonOnClick"
                                                       Content="Setup" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="GitHubCopilotProviderEnabledCheckBox"
                                                          Content="GitHub Copilot"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Premium request quota via internal Copilot API (undocumented)."
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="GitHubCopilotApiKeySummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1"
                                                       Width="82"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Appearance="Secondary"
                                                       Click="GitHubCopilotSetupButtonOnClick"
                                                       Content="Setup" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Overlay window" />
                        <CheckBox x:Name="OverlaySnapToScreenCheckBox"
                                  Margin="0,10,0,0"
                                  Content="Enable snap to screen"
                                  FontSize="13" />
                        <TextBlock Margin="24,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Drag the usage overlay to a monitor edge to dock it along that edge."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <CheckBox x:Name="AutoRunAtLoginCheckBox"
                                  Content="Auto run at login"
                                  FontSize="13" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <CheckBox x:Name="WaifuSquadCheckBox"
                                  Content="Waifu Squad"
                                  FontSize="13" />
                        <TextBlock Margin="24,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Show background artwork on provider cards." />
                    </StackPanel>

                    <TextBlock x:Name="ValidationTextBlock"
                               Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Width="92"
                           HorizontalAlignment="Left"
                           Appearance="Secondary"
                           Click="AboutButtonOnClick"
                           Content="About" />

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ui:Button Width="92"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Click="CancelButtonOnClick"
                               Content="Cancel" />
                    <ui:Button Width="92"
                               Appearance="Primary"
                               Click="SaveButtonOnClick"
                               Content="Save" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</local:FluentAppWindow>
