<Window x:Class="AIUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seth's AI Usage Monitor Settings"
        Width="540"
        Height="700"
        MinWidth="500"
        MinHeight="620"
        Background="#15171D"
        Foreground="#F9FAFB"
        Icon="/Assets/AppIcon.ico"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Padding="22" Background="#15171D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#F9FAFB"
                       Text="Settings" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#D6DAE1"
                                   Text="Update interval" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox x:Name="UpdateIntervalTextBox"
                                     Width="96"
                                     Height="34"
                                     Padding="8,5"
                                     VerticalContentAlignment="Center"
                                     Background="#1D2028"
                                     BorderBrush="#343A46"
                                     CaretBrush="#F9FAFB"
                                     FontSize="14"
                                     Foreground="#F9FAFB" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="#A8AFBA"
                                       Text="minutes" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#8B93A1"
                                   Text="Default is 20. Manual refresh still runs immediately." />
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#D6DAE1"
                                   Text="Providers" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#8B93A1"
                                   Text="Enabled providers appear in the overlay and are included in refreshes." />
                        <Border Margin="0,10,0,0"
                                Background="#1A1D25"
                                BorderBrush="#303641"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer MaxHeight="380"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AnthropicProviderEnabledCheckBox"
                                                          Content="Anthropic"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#D6DAE1" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#8B93A1"
                                                           Text="Claude Code local OAuth and status-line quota data."
                                                           TextWrapping="Wrap" />
                                                <CheckBox x:Name="ClaudeStatusExporterCheckBox"
                                                          Margin="24,10,0,0"
                                                          Content="Install Claude Code status exporter automatically"
                                                          FontSize="12"
                                                          Foreground="#D6DAE1" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Click="ProviderSetupButtonOnClick"
                                                    Content="Setup"
                                                    Tag="Anthropic" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="OpenAiProviderEnabledCheckBox"
                                                          Content="OpenAI"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#D6DAE1" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#8B93A1"
                                                           Text="Codex local session logs and CLI quota refreshes."
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Click="ProviderSetupButtonOnClick"
                                                    Content="Setup"
                                                    Tag="OpenAI" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="GeminiProviderEnabledCheckBox"
                                                          Content="Gemini"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#D6DAE1" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#8B93A1"
                                                           Text="Gemini CLI credentials, quota status export, and local session data."
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Click="ProviderSetupButtonOnClick"
                                                    Content="Setup"
                                                    Tag="Gemini" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="CursorProviderEnabledCheckBox"
                                                          Content="Cursor"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#D6DAE1" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#8B93A1"
                                                           Text="Personal dashboard login or Teams Admin API spend data."
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="CursorModeSummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           FontSize="12"
                                                           Foreground="#A8AFBA"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Click="CursorSetupButtonOnClick"
                                                    Content="Setup" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#2A303A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="DeepSeekProviderEnabledCheckBox"
                                                          Content="DeepSeek"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#D6DAE1" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#8B93A1"
                                                           Text="DeepSeek API credit balance via API key."
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="DeepSeekApiKeySummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           FontSize="12"
                                                           Foreground="#A8AFBA"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Click="DeepSeekSetupButtonOnClick"
                                                    Content="Setup" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="GitHubCopilotProviderEnabledCheckBox"
                                                          Content="GitHub Copilot"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          Foreground="#D6DAE1" />
                                                <TextBlock Margin="24,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#8B93A1"
                                                           Text="Premium request quota via internal Copilot API (undocumented)."
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="GitHubCopilotApiKeySummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           FontSize="12"
                                                           Foreground="#A8AFBA"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Click="GitHubCopilotSetupButtonOnClick"
                                                    Content="Setup" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <CheckBox x:Name="AutoRunAtLoginCheckBox"
                                  Content="Auto run at login"
                                  FontSize="13"
                                  Foreground="#D6DAE1" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <CheckBox x:Name="WaifuSquadCheckBox"
                                  Content="Waifu Squad"
                                  FontSize="13"
                                  Foreground="#D6DAE1" />
                        <TextBlock Margin="24,4,0,0"
                                   FontSize="12"
                                   Foreground="#8B93A1"
                                   Text="Show background artwork on provider cards." />
                    </StackPanel>

                    <TextBlock x:Name="ValidationTextBlock"
                               Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Width="92"
                        Height="34"
                        HorizontalAlignment="Left"
                        Click="AboutButtonOnClick"
                        Content="About" />

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="92"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="CancelButtonOnClick"
                            Content="Cancel" />
                    <Button Width="92"
                            Height="34"
                            Click="SaveButtonOnClick"
                            Content="Save" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
