<local:FluentAppWindow x:Class="AIUsageMonitor.Views.UsageOverlayWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:AIUsageMonitor.Views"
                       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                       Title="Seth's AI Usage Monitor"
                       Width="900"
                       Height="760"
                       MinWidth="320"
                       MinHeight="56"
                       PreviewKeyDown="WindowOnPreviewKeyDown"
                       PreviewMouseLeftButtonDown="WindowOnPreviewMouseLeftButtonDown"
                       ResizeMode="CanResize"
                       ShowInTaskbar="False"
                       Topmost="True"
                       ExtendsContentIntoTitleBar="True"
                       WindowBackdropType="Mica"
                       WindowCornerPreference="Round"
                       WindowStartupLocation="CenterScreen"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                       ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <local:FluentAppWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FullOnlyElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactOnlyElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniOnlyElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotMiniElementStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderCardFullContentStyle"
               TargetType="{x:Type Grid}"
               BasedOn="{StaticResource FullOnlyElementStyle}">
            <Setter Property="Margin" Value="18" />
        </Style>

        <Style x:Key="ProviderCardCompactContentStyle"
               TargetType="{x:Type StackPanel}"
               BasedOn="{StaticResource CompactOnlyElementStyle}">
            <Setter Property="Margin" Value="8" />
        </Style>

        <Style x:Key="ProviderCardMiniContentStyle"
               TargetType="{x:Type StackPanel}"
               BasedOn="{StaticResource MiniOnlyElementStyle}">
            <Setter Property="Margin" Value="6,4" />
        </Style>

        <Style x:Key="ProviderCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="190" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="MinHeight" Value="92" />
                    <Setter Property="CornerRadius" Value="6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="Margin" Value="3,2" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="4" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Inner fill + waifu clip sit inside the 1px border so the stroke is not clipped away at corners. -->
        <Style x:Key="ProviderCardInnerStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="local:RoundedCornerClip.ClipRadius" Value="7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="local:RoundedCornerClip.ClipRadius" Value="5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                    <Setter Property="CornerRadius" Value="3" />
                    <Setter Property="local:RoundedCornerClip.ClipRadius" Value="3" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayTitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="FontSize" Value="22" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsageProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </local:FluentAppWindow.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Click="HideButtonOnClick" Header="Hide" />
                <MenuItem Click="RefreshMenuItemOnClick" Header="Refresh Now" />
                <MenuItem Click="SettingsMenuItemOnClick" Header="Settings" />
                <MenuItem Click="LogsMenuItemOnClick" Header="Logs" />
                <Separator />
                <MenuItem Click="ExitMenuItemOnClick" Header="Exit" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Border x:Name="ChromeInset"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Padding" Value="18,16,18,16" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSideToolbar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Padding" Value="12,8,4,8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHorizontalDock, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Padding" Value="8,4,4,4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSnapReservedDock, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderChromeGrid"
                  Grid.Row="0"
                  Margin="6,0,6,8">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHorizontalDock, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Style="{StaticResource FullOnlyElementStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OverlayTitleTextStyle}"
                                   Text="Seth's AI Usage Monitor" />
                        <Border Margin="12,3,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding AppVersionText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding GeneratedAtText}" />
                </StackPanel>

                <StackPanel x:Name="TopToolbarStack"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSideToolbar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:Button Margin="0"
                               Appearance="Secondary"
                               Click="SettingsButtonOnClick"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"
                               ToolTip="Settings" />
                    <ui:Button Margin="6,0,0,0"
                               Appearance="Secondary"
                               Click="ReloadButtonOnClick"
                               Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                               ToolTip="Refresh now" />
                    <ui:Button Margin="6,0,0,0"
                               Appearance="Secondary"
                               Click="LogsButtonOnClick"
                               Icon="{ui:SymbolIcon Symbol=DocumentText24}"
                               ToolTip="Logs" />
                    <ui:Button Margin="6,0,0,0"
                               Appearance="Secondary"
                               Click="MinimizeButtonOnClick"
                               Icon="{ui:SymbolIcon Symbol=WindowMinimize24}"
                               ToolTip="Minimize">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowMinimizeButton, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Margin="6,0,0,0"
                               Appearance="Secondary"
                               Click="HideButtonOnClick"
                               Icon="{ui:SymbolIcon Symbol=Dismiss24}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="ToolTip" Value="Hide" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowMinimizeButton, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="ToolTip" Value="Exit" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ContentRoot"
                  Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="6,0,6,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSideToolbar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="6,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,10"
                            Background="{StaticResource ErrorBackgroundBrush}"
                            BorderBrush="{StaticResource ErrorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Margin" Value="0,18,0,0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasError}" Value="True" />
                                            <Condition Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Full" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasError}" Value="True" />
                                            <Condition Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Margin" Value="0,12,0,0" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="13" Foreground="{StaticResource ErrorTextBrush}"
                                       Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            <ui:Button Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Top"
                                       Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Symbol=Dismiss16}"
                                       Click="DismissErrorButtonOnClick"
                                       ToolTip="Dismiss" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ProvidersScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Margin" Value="0,12,0,0" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProviders}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl x:Name="ProvidersList"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Providers}"
                                      SizeChanged="ProvidersListOnSizeChanged">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"
                                               ItemWidth="{Binding CardSlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ItemHeight="{Binding CardSlotHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Width" Value="{Binding CardSlotWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="Height" Value="{Binding CardSlotHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Style="{StaticResource ProviderCardStyle}"
                                            RenderTransformOrigin="0.5,0.5"
                                            MouseEnter="ProviderCard_MouseEnter"
                                            MouseLeave="ProviderCard_MouseLeave"
                                            MouseMove="ProviderCard_MouseMove"
                                            MouseRightButtonUp="ProviderCard_MouseRightButtonUp">
                                        <Border Style="{StaticResource ProviderCardInnerStyle}">
                                        <Grid>
                                            <Image HorizontalAlignment="Right"
                                                   VerticalAlignment="Stretch"
                                                   IsHitTestVisible="False"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Opacity="{Binding DataContext.WaifuBackgroundOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Source="{Binding BackgroundImage}"
                                                   Stretch="UniformToFill">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform/>
                                                        <TranslateTransform/>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                                <Image.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 From="1.1" To="1.15" Duration="0:0:35">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 From="1.1" To="1.15" Duration="0:0:35">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                                 From="0" To="-22" Duration="0:0:35">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                 From="0" To="-12" Duration="0:0:35">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Image.Triggers>
                                            </Image>
                                            <Grid Style="{StaticResource ProviderCardFullContentStyle}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="4"
                                                            Height="28"
                                                            Margin="0,0,12,0"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="2" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource CardTextPrimaryBrush}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <Border Padding="9,4"
                                                                Background="{Binding OverallStatusBackground}"
                                                                CornerRadius="8"
                                                                Visibility="{Binding IsStatusBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding OverallStatusBrush}"
                                                                       Text="{Binding OverallStatusLabel}" />
                                                        </Border>
                                                        <TextBlock Margin="0,6,0,0"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource CardTextDimBrush}"
                                                                   Text="{Binding CheckedText}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                                    <TextBlock FontSize="13"
                                                               Foreground="{StaticResource CardTextMutedBrush}"
                                                               Text="{Binding StatusMessage}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <ItemsControl ItemsSource="{Binding Windows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,18">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource CardTextSubtleBrush}"
                                                                                   Text="{Binding Title}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource CardTextBrightBrush}"
                                                                                   Text="{Binding RemainingText}" />
                                                                    </Grid>

                                                                    <ProgressBar Margin="0,8,0,0"
                                                                                 Foreground="{Binding ProgressBrush}"
                                                                                 Style="{StaticResource UsageProgressBarStyle}"
                                                                                 Value="{Binding RemainingPercent, Mode=OneWay}" />

                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="{StaticResource CardTextMutedBrush}"
                                                                                   Text="{Binding LimitText}" />
                                                                        <StackPanel Grid.Column="1"
                                                                                    HorizontalAlignment="Right"
                                                                                    Orientation="Horizontal">
                                                                            <TextBlock FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{Binding ResetRelativeBrush}"
                                                                                       Text="{Binding ResetRelativeText}" />
                                                                            <TextBlock Margin="10,0,0,0"
                                                                                       FontSize="12"
                                                                                       Foreground="{StaticResource CardTextMutedBrush}"
                                                                                       Text="{Binding ResetText}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Style="{StaticResource ProviderCardCompactContentStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource CardTextPrimaryBrush}"
                                                               Text="{Binding SummaryText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            Padding="7,3"
                                                            Background="{Binding OverallStatusBackground}"
                                                            CornerRadius="7"
                                                            Visibility="{Binding IsStatusBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding OverallStatusBrush}"
                                                                   Text="{Binding OverallStatusLabel}" />
                                                    </Border>
                                                </Grid>

                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Windows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock MinWidth="58"
                                                                           MaxWidth="130"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource CardTextMutedBrush}"
                                                                           Text="{Binding Title}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <ProgressBar Grid.Column="1"
                                                                             Height="6"
                                                                             Margin="8,0,8,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{Binding ProgressBrush}"
                                                                             Style="{StaticResource UsageProgressBarStyle}"
                                                                             Value="{Binding RemainingPercent, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="2"
                                                                           Margin="8,0,0,0"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding ResetRelativeBrush}"
                                                                           Text="{Binding ResetRelativeText}" />
                                                                <TextBlock Grid.Column="3"
                                                                           Margin="8,0,0,0"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource CardTextSubtleBrush}"
                                                                           Text="{Binding RemainingText}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Style="{StaticResource ProviderCardMiniContentStyle}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource CardTextPrimaryBrush}"
                                                           Text="{Binding SummaryText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="6"
                                                             Margin="0,4,0,0"
                                                             Foreground="{Binding SummaryProgressBrush}"
                                                             Style="{StaticResource UsageProgressBarStyle}"
                                                             Value="{Binding PrimaryRemainingPercent, Mode=OneWay}" />
                                            </StackPanel>
                                            <Border IsHitTestVisible="False"
                                                    Opacity="0"
                                                    Tag="ShimmerOverlay" />
                                        </Grid>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="{StaticResource EmptyStateBackgroundBrush}"
                            BorderBrush="{StaticResource EmptyStateBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Margin" Value="0,18,0,0" />
                                <Setter Property="Padding" Value="16" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProviders}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="12" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Mini">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="8,6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="13" Foreground="{StaticResource CardTextMutedBrush}"
                                       Text="No providers enabled. Open Settings to enable one."
                                       TextWrapping="Wrap" />
                            <ui:Button Margin="0,10,0,0"
                                       HorizontalAlignment="Left"
                                       Appearance="Secondary"
                                       Content="Open Settings"
                                       Click="SettingsButtonOnClick" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,12,0,4"
                          Style="{StaticResource FullOnlyElementStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding SourcePathText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding LogSummaryText}" />
                        <TextBlock Grid.Column="2"
                                   Margin="16,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding AutoRefreshText}" />
                    </Grid>
                </Grid>
            </Grid>
            </Grid>

            <StackPanel x:Name="SideToolbarStack"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSideToolbar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Margin" Value="4,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:Button Margin="0"
                           Appearance="Secondary"
                           Click="SettingsButtonOnClick"
                           Icon="{ui:SymbolIcon Symbol=Settings24}"
                           ToolTip="Settings" />
                <ui:Button Margin="0,4,0,0"
                           Appearance="Secondary"
                           Click="ReloadButtonOnClick"
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                           ToolTip="Refresh now" />
                <ui:Button Margin="0,4,0,0"
                           Appearance="Secondary"
                           Click="LogsButtonOnClick"
                           Icon="{ui:SymbolIcon Symbol=DocumentText24}"
                           ToolTip="Logs" />
                <ui:Button Margin="0,4,0,0"
                           Appearance="Secondary"
                           Click="MinimizeButtonOnClick"
                           Icon="{ui:SymbolIcon Symbol=WindowMinimize24}"
                           ToolTip="Minimize">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMinimizeButton, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Margin="0,4,0,0"
                           Appearance="Secondary"
                           Click="HideButtonOnClick"
                           Icon="{ui:SymbolIcon Symbol=Dismiss24}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="ToolTip" Value="Hide" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMinimizeButton, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="ToolTip" Value="Exit" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:FluentAppWindow>
