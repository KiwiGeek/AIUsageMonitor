<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.DeepSeekPeakWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Set DeepSeek Peak Balance"
                 Width="440"
                 Height="250"
                 MinWidth="400"
                 MinHeight="230"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Set DeepSeek Peak Balance"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="CurrencyLabel"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox x:Name="PeakTextBox"
                            Height="34"
                            Margin="0,6,0,0"
                            FontFamily="Consolas"
                            FontSize="13"
                            PlaceholderText="20.00" />
                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Text="Used as 100% for the credit bar. Auto-detected from the highest balance seen — set this manually if the auto-detected value is too low." />
                <TextBlock x:Name="ValidationTextBlock"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Width="92"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Cancel"
                           Click="CancelButtonOnClick" />
                <ui:Button Width="92"
                           Appearance="Primary"
                           Content="Save"
                           Click="SaveButtonOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</local:FluentDialogWindow>
