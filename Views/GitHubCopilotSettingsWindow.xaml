<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.GitHubCopilotSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="GitHub Copilot Settings"
                 Width="500"
                 Height="340"
                 MinWidth="460"
                 MinHeight="300"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="GitHub Copilot Settings"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <!-- Enabled -->
                <CheckBox Margin="0,4,0,16"
                          FontSize="13"
                          Content="Enable GitHub Copilot"
                          IsChecked="{Binding GitHubCopilotEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- PAT -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Personal Access Token"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding GitHubCopilotApiKeyStatus}" />
                </Grid>
                <ui:TextBox Height="34"
                            Margin="0,0,0,6"
                            FontFamily="Consolas"
                            FontSize="13"
                            PlaceholderText="ghp_..."
                            Text="{Binding GitHubCopilotApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap">
                    Create a classic PAT (no scopes required) at
                    <Hyperlink NavigateUri="https://github.com/settings/tokens"
                               RequestNavigate="HyperlinkOnRequestNavigate">github.com/settings/tokens</Hyperlink>.
                    The account must have an active Copilot subscription. Fine-grained tokens may need the Copilot Editor Chat (read-only) permission.
                </TextBlock>

            </StackPanel>

            <TextBlock Grid.Row="1"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Changes are saved automatically." />
        </Grid>
    </Grid>
</local:FluentDialogWindow>
