<local:FluentDialogWindow x:Class="AIUsageMonitor.Views.DeepSeekSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DeepSeek Settings"
                 Width="460"
                 Height="400"
                 MinWidth="420"
                 MinHeight="360"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="DeepSeek Settings"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <!-- Enabled -->
                <CheckBox Margin="0,4,0,16"
                          FontSize="13"
                          Content="Enable DeepSeek"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- API Key -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API key"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding ApiKeyStatus}" />
                </Grid>
                <ui:TextBox Height="34"
                            Margin="0,0,0,6"
                            FontFamily="Consolas"
                            FontSize="13"
                            PlaceholderText="sk-..."
                            Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,0,0,20"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap">
                    Create or copy an API key from
                    <Hyperlink NavigateUri="https://platform.deepseek.com/api_keys"
                               RequestNavigate="HyperlinkOnRequestNavigate">platform.deepseek.com/api_keys</Hyperlink>
                </TextBlock>

                <!-- Peak balance -->
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding PeakLabel}" />
                <ui:TextBox Height="34"
                            Margin="0,6,0,6"
                            FontFamily="Consolas"
                            FontSize="13"
                            PlaceholderText="20.00"
                            Text="{Binding PeakBalanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Text="Used as 100% for the credit bar. Auto-detected from the highest balance seen — set this manually if the auto-detected value is too low." />
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap"
                           Text="{Binding PeakValidationMessage}" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Changes are saved automatically." />
        </Grid>
    </Grid>
</local:FluentDialogWindow>
