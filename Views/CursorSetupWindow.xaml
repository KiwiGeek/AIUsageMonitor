<local:FluentAppWindow x:Class="AIUsageMonitor.Views.CursorSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:AIUsageMonitor.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Cursor Setup"
                 Width="580"
                 Height="520"
                 MinWidth="540"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Icon="/Assets/AppIcon.ico"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Cursor Setup"
                     Grid.Row="0" />

        <Grid Grid.Row="1"
              Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Margin="0,0,0,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <RadioButton x:Name="PersonalSubscriptionRadioButton"
                                 Content="Personal subscription"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Checked="CursorModeRadioButtonOnChecked" />
                    <TextBlock Margin="24,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Use the Cursor dashboard login for personal Pro, Pro+, Ultra, or Max accounts."
                               TextWrapping="Wrap" />
                    <ui:Button x:Name="DashboardLoginButton"
                               Width="180"
                               Margin="24,12,0,0"
                               HorizontalAlignment="Left"
                               Appearance="Secondary"
                               Content="Open dashboard login"
                               Click="DashboardLoginButtonOnClick" />
                    <TextBlock x:Name="DashboardLoginStatusTextBlock"
                               Margin="24,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,18,0,18"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="0,1,0,0" />

                    <RadioButton x:Name="TeamsApiKeyRadioButton"
                                 Content="Cursor Teams Admin API key"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Checked="CursorModeRadioButtonOnChecked" />
                    <TextBlock Margin="24,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Use Cursor Teams spend data and compare it to a configured monthly included budget."
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="TeamsApiSettingsPanel"
                                Margin="24,12,0,0">
                        <TextBlock Text="Teams Admin API key"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox x:Name="CursorApiKeyTextBox"
                                    Height="34"
                                    Margin="0,6,0,0"
                                    FontSize="13" />
                        <DockPanel Margin="0,10,0,0">
                            <ui:TextBox x:Name="CursorBudgetTextBox"
                                        Width="96"
                                        FontSize="14" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="monthly included budget dollars" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Teams Admin API keys start with key_. Personal crsr_ keys will not work here."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="ValidationTextBlock"
                               Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Width="92"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Close"
                           Click="CloseButtonOnClick" />
                <ui:Button Width="92"
                           Appearance="Primary"
                           Content="Save"
                           Click="SaveButtonOnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</local:FluentAppWindow>
